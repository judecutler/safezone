# Copy this file to .env and paste your real key after the equals sign.
# .env is ignored by git. Never put a real key in this file.
MODEL_API_KEY=

# Hard lifetime cap on paid Meta API calls from this project.
# Every attempt is counted in .cache/meta/ledger.jsonl. Delete that file to reset.
MAX_API_CALLS=15

# Set to 1 to forbid all network calls to Meta and serve only cached responses.
SAFEZONE_OFFLINE=0
